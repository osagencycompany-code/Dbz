{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "À incrémenter à chaque changement, avec une décision dans docs/decisions/"
    },
    "raretes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[1-5]$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "niveau_max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "niveau_max"
        ],
        "additionalProperties": false
      }
    },
    "evolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "de": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "vers": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "bonus_stats_pct": {
            "type": "number",
            "minimum": 0
          },
          "objets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "objet": {
                  "type": "string"
                },
                "nombre": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "objet",
                "nombre"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "de",
          "vers",
          "bonus_stats_pct",
          "objets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "raretes",
    "evolutions"
  ],
  "additionalProperties": false
}
