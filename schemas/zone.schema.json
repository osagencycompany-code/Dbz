{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "niveaux": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "monstres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deblocage": {
      "type": [
        "string",
        "null"
      ]
    },
    "point_de_soin": {
      "type": [
        "string",
        "null"
      ]
    },
    "carte_du_monde": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "niveaux",
    "maps",
    "monstres"
  ],
  "additionalProperties": false
}
