{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "emplacement": {
      "type": "string",
      "enum": [
        "tete",
        "torse",
        "gants",
        "bottes",
        "accessoire",
        "consommable",
        "quete",
        "evolution"
      ]
    },
    "rarete": {
      "type": "string",
      "enum": [
        "commun",
        "rare",
        "epique",
        "legendaire",
        "relique"
      ]
    },
    "stats": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "vitalite",
          "force",
          "puissance",
          "agilite",
          "energie"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "prix": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "icone": {
      "type": [
        "string",
        "null"
      ]
    },
    "empilable": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "emplacement",
    "rarete",
    "stats",
    "prix"
  ],
  "additionalProperties": false
}
