{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "sprite": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "dbz-online",
                "buus-fury",
                "legacy-of-goku-1",
                "legacy-of-goku-2",
                "maison",
                "a-creer",
                "a-choisir"
              ]
            },
            "fichier": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "type": "string"
            },
            "cadre": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            },
            "variante": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "animations": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "fichier",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "zone": {
      "type": "string"
    },
    "dialogues": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "zone"
  ],
  "additionalProperties": false
}
