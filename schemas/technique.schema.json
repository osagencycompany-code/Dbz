{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "touche_defaut": {
      "type": "string"
    },
    "touche_alternative": {
      "type": "string"
    },
    "cout": {},
    "multiplicateur": {},
    "parametres": {
      "type": "string"
    },
    "apprentissage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "depart",
            "quete",
            "niveau",
            "heros"
          ]
        },
        "quete": {
          "type": "string"
        },
        "maitre": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "touche_defaut",
    "apprentissage",
    "description"
  ],
  "additionalProperties": false
}
