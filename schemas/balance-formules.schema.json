          "type": "number"
        }
      },
      "required": [
        "max_pct",
        "max_pvp_pct",
        "exposant"
      ],
      "additionalProperties": false
    },
    "vitesse": {
      "type": "object",
      "properties": {
        "base_px_s": {
          "type": "number"
        },
        "bonus": {
          "type": "number"
        },
        "exposant": {
          "type": "number"
        },
        "course": {
          "type": "number"
        },
        "vol": {
          "type": "number"
        },
        "super_saiyan": {
          "type": "number"
        }
      },
      "required": [
        "base_px_s",
        "bonus",
        "exposant",
        "course",
        "vol",
        "super_saiyan"
