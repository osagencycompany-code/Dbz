      "required": [
        "coef",
        "exposant"
      ],
      "additionalProperties": false
    },
    "pv": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number"
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false
    },
    "degats_melee": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number"
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false
    },
    "degats_ki": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number"
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false
    },
    "ki_max": {
      "type": "object",
      "properties": {
        "base": {
          "type": "number"
        }
      },
      "required": [
        "base"
      ],
      "additionalProperties": false
    },
    "esquive": {
      "type": "object",
      "properties": {
        "max_pct": {
          "type": "number"
        },
        "max_pvp_pct": {
          "type": "number"
