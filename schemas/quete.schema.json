{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quête",
  "type": "object",
  "required": [
    "id",
    "nom",
    "statut",
    "arc",
    "niveau_conseille",
    "donneur",
    "objectifs",
    "recompenses"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "description": "Nom affiché en jeu, conforme à docs/lore/glossaire.md"
    },
    "statut": {
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ],
      "description": "brouillon = en attente de validation par Souleymen"
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "arc": {
      "enum": [
        "saiyan",
        "namek",
        "cell",
        "buu",
        "annexe"
      ]
    },
    "niveau_conseille": {
      "type": "integer"
    },
    "donneur": {
      "type": "string"
    },
    "prerequis": {
      "type": [
        "string",
        "null"
      ]
    },
    "objectifs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ]
      }
    },
    "recompenses": {
      "type": "object"
    }
  },
  "additionalProperties": false
}