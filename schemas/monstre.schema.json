{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "rang": {
      "type": "string",
      "enum": [
        "commun",
        "elite"
      ]
    },
    "niveau": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "sprite": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "dbz-online",
                "buus-fury",
                "maison",
                "a-creer",
                "a-choisir"
              ]
            },
            "fichier": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "fichier",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "comportement": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "immobile",
            "poursuite",
            "meute",
            "charge",
            "bond"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "butin": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objet": {
            "type": "string"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "objet",
          "chance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "rang",
    "niveau",
    "sprite",
    "comportement",
    "zones"
  ],
  "additionalProperties": false
}
