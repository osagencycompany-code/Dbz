{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "race": {
      "type": "string"
    },
    "niveau_requis": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "quete_requise": {
      "type": "string"
    },
    "bonus_combat": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "vitesse_mult": {
      "type": "number"
    },
    "multiplicateur_affiche": {
      "type": "number"
    },
    "ki_requis_pct": {
      "type": "number"
    },
    "cout_ki_pct_s": {
      "type": "number"
    },
    "cout_activation_ki_pct": {
      "type": "number"
    },
    "duree_transformation_s": {
      "type": "number"
    },
    "forme": {
      "type": "string"
    },
    "cinematique_deblocage": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "race",
    "niveau_requis",
    "bonus_combat",
    "multiplicateur_affiche"
  ],
  "additionalProperties": false
}
