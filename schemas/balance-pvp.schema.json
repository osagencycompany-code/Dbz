{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "À incrémenter à chaque changement, avec une décision dans docs/decisions/"
    },
    "duel": {
      "type": "object",
      "properties": {
        "duree_max_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delai_entre_invitations_s": {
          "type": "number",
          "minimum": 0
        },
        "invitation_expire_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "perte_xp_pct": {
          "type": "number",
          "minimum": 0
        },
        "perte_zenies_pct": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "duree_max_s",
        "delai_entre_invitations_s",
        "invitation_expire_s",
        "perte_xp_pct",
        "perte_zenies_pct"
      ],
      "additionalProperties": false
    },
    "ecart_niveau": {
      "type": "object",
      "properties": {
        "ecart_max_jusqu_au_seuil": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "niveau_seuil": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ecart_max_pct_au_dela": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "ecart_max_jusqu_au_seuil",
        "niveau_seuil",
        "ecart_max_pct_au_dela"
      ],
      "additionalProperties": false
    },
    "zone_libre": {
      "type": "object",
      "properties": {
        "disponible_en_beta": {
          "type": "boolean"
        },
        "perte_zenies_pct": {
          "type": "number",
          "minimum": 0
        },
        "chance_lacher_objet_equipe_pct": {
          "type": "number",
          "minimum": 0
        },
        "invulnerabilite_reapparition_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "disponible_en_beta",
        "perte_zenies_pct",
        "chance_lacher_objet_equipe_pct",
        "invulnerabilite_reapparition_s"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "duel",
    "ecart_niveau",
    "zone_libre"
  ],
  "additionalProperties": false
}
