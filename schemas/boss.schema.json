{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ]
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "niveau": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sprite": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "dbz-online",
                "buus-fury",
                "maison",
                "a-creer",
                "a-choisir"
              ]
            },
            "fichier": {
              "type": [
                "string",
                "null"
              ]
            },
            "format": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "fichier",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "zone": {
      "type": "string"
    },
    "respawn_s": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "echelle_sprite": {
      "type": "number"
    },
    "contribution_min_pct": {
      "type": "number"
    },
    "butin": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objet": {
            "type": "string"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "objet",
          "chance"
        ],
        "additionalProperties": false
      }
    },
    "phases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pv_pct": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "attaques": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nom": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "nom",
                "type"
              ],
              "additionalProperties": {}
            }
          },
          "aura": {
            "type": "string"
          },
          "vitesse_bonus_pct": {
            "type": "number"
          },
          "invocations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "monstre": {
                  "type": "string"
                },
                "nombre": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "recharge_s": {
                  "type": "number"
                }
              },
              "required": [
                "monstre",
                "nombre"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "pv_pct"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "nom",
    "statut",
    "niveau",
    "sprite",
    "zone",
    "respawn_s",
    "phases"
  ],
  "additionalProperties": false
}
