{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Boss",
  "type": "object",
  "required": [
    "id",
    "nom",
    "statut",
    "niveau",
    "sprite",
    "zone",
    "phases",
    "respawn_s"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nom": {
      "type": "string",
      "description": "Nom affiché en jeu, conforme à docs/lore/glossaire.md"
    },
    "statut": {
      "enum": [
        "brouillon",
        "valide",
        "obsolete"
      ],
      "description": "brouillon = en attente de validation par Souleymen"
    },
    "a_verifier": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "niveau": {
      "type": "integer"
    },
    "sprite": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "source",
        "fichier",
        "format"
      ],
      "properties": {
        "source": {
          "enum": [
            "dbz-online",
            "buus-fury",
            "maison",
            "a-creer",
            "a-choisir"
          ]
        },
        "fichier": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "zone": {
      "type": "string"
    },
    "respawn_s": {
      "type": "integer"
    },
    "echelle_sprite": {
      "type": "number"
    },
    "contribution_min_pct": {
      "type": "number"
    },
    "butin": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objet",
          "chance"
        ],
        "properties": {
          "objet": {
            "type": "string",
            "description": "id dans data/items"
          },
          "chance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pv_pct",
          "attaques"
        ],
        "properties": {
          "pv_pct": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "attaques": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nom",
                "type"
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}