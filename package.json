{
  "name": "dbz-my-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "DBZ MY GAME – MMORPG 2D dans le navigateur",
  "workspaces": [
    "apps/client",
    "apps/server",
    "packages/shared"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:types && npm run check:tests && npm run check:donnees",
    "check:types": "tsc -b",
    "check:tests": "vitest run",
    "check:donnees": "tsx scripts/check-donnees.ts",
    "schemas:build": "tsx scripts/build-schemas.ts",
    "assets:build": "tsx scripts/build-assets.ts",
    "assets:maison": "tsx scripts/build-maison.ts",
    "dev": "tsx watch --tsconfig apps/server/tsconfig.json apps/server/src/index.ts",
    "start": "tsx --tsconfig apps/server/tsconfig.json apps/server/src/index.ts",
    "invite:create": "tsx --tsconfig apps/server/tsconfig.json apps/server/src/outils/invitation.ts",
    "admin:grant": "tsx --tsconfig apps/server/tsconfig.json apps/server/src/outils/admin-grant.ts",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "build:client": "vite build --config apps/client/vite.config.ts",
    "test:e2e": "playwright test",
    "jouer": "tsx --tsconfig apps/server/tsconfig.json apps/server/src/outils/jouer.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "argon2": true,
    "better-sqlite3": true,
    "msgpackr-extract": true
  }
}
