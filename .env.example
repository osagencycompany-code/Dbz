# Copier en .env pour changer les valeurs par défaut (le fichier .env n'est jamais commité).
PORT=2567
# Chemin du fichier SQLite (par défaut data-runtime/dbz.sqlite)
# DB_PATH=
# Obligatoire en production (NODE_ENV=production). En développement, un secret est créé dans .dev-secret.
# SESSION_SECRET=
# Commandes d'administration : off par défaut, et réservées aux comptes admin.
ADMIN_COMMANDS=off
# Tentatives d'inscription/connexion par minute et par adresse
ESSAIS_PAR_MINUTE=10
